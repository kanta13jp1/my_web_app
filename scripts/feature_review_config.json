{
  "_comment": "feature-review schedule task 対象機能リスト (Win版#132 part 78 / 2026-04-29 / 毎時運用 + rotation)",
  "_schema_version": "1.1",
  "_changelog": [
    {"version": "1.0", "part": 77, "date": "2026-04-29", "change": "初版 / 週次 cron"},
    {"version": "1.1", "part": 78, "date": "2026-04-29", "change": "毎時 cron + rotation 設計 + throttle 強化"}
  ],
  "_review_categories": [
    "ui_bug",
    "a11y",
    "stale_todo",
    "dead_code",
    "outdated_docs",
    "lint_warning",
    "performance"
  ],
  "_severity_levels": ["low", "medium", "high"],
  "production_url": "https://my-web-app-b67f4.web.app",
  "review_targets": {

def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--config", required=True, type=Path, help="config JSON path")
    parser.add_argument("--dry-run", action="store_true", help="Issue 起票せず log のみ")
    parser.add_argument("--targets", default="", help="対象機能 slug カンマ区切り (= rotation 上書き)")
    parser.add_argument("--force-full-scan", action="store_true", help="全機能巡回 (= 緊急 audit / rotation 無視)")
    args = parser.parse_args(argv)

    if not args.config.exists():
        print(f"[FAIL] config not found: {args.config}", file=sys.stderr)
        return 2

    config = load_config(args.config)
    repo_root = Path(__file__).resolve().parent.parent

    # = 対象機能決定 logic
    # 1. --targets 明示 → それのみ
    # 2. --force-full-scan → 全機能
    # 3. それ以外 (= 通常 cron) → rotation で 1 機能のみ
    if args.targets:
        target_filter = set(s.strip() for s in args.targets.split(",") if s.strip())
    elif args.force_full_scan:
        target_filter = None  # = 全機能
    else:
        rotation_target = select_feature_for_this_hour(config)
        if rotation_target is None:
            print("[FAIL] rotation.feature_order 未設定", file=sys.stderr)
            return 2
        target_filter = {rotation_target}
        print(f"[INFO] rotation: this hour = {rotation_target}")

    # = 既存 open issue hash 取得 (de-dupe 用)
    # existing_hashes = existing_open_issue_hashes()

    stats = {"new_count": 0, "skipped_count": 0, "error_count": 0, "details": []}

    # === Codex#2 実装 ===
    # for page in config["review_targets"]["pages"]:
    #     if target_filter and page["slug"] not in target_filter:
    #         continue
    #     try:
    #         signals = collect_page_signals(page, config["production_url"])
    #         findings = claude_review(signals, page, config["claude_review"])
    #         for finding in findings[:config["throttle"]["max_findings_per_feature"]]:
    #             h = issue_title_hash(finding["feature_slug"], finding["category"], finding["summary"])
    #             if h in existing_hashes:
    #                 stats["skipped_count"] += 1
    #                 continue
    #             ok = create_issue({**finding, "hash": h}, config["issue_template"], args.dry_run)
    #             if ok:
    #                 stats["new_count"] += 1
    #             else:
    #                 stats["error_count"] += 1
    #     except Exception as e:
    #         stats["error_count"] += 1
    #         stats["details"].append(f"{page['slug']}: {type(e).__name__}: {e}")
    # ... (= edge_functions も同様)

    print(f"[STUB] Codex#2 implementation pending. Config OK: {len(config['review_targets']['pages'])} pages, {len(config['review_targets']['edge_functions'])} EFs")
    print(f"[STUB] dry_run={args.dry_run} targets={target_filter or 'ALL'}")

    # = 集計サマリ書出 (= GHA Slack notify step が読む)
    summary_path = Path("/tmp/feature-review-summary.json")
    summary_path.write_text(json.dumps(stats, ensure_ascii=False), encoding="utf-8")

    log_path = Path("/tmp/feature-review.log")
    log_path.write_text(
        f"# Feature Review Log (skeleton stub)\n\n"
        f"- new_count: {stats['new_count']}\n"
        f"- skipped_count: {stats['skipped_count']}\n"
        f"- error_count: {stats['error_count']}\n"
        f"- dry_run: {args.dry_run}\n"
        f"- targets: {target_filter or 'ALL'}\n",
        encoding="utf-8",
    )

    return 0


if __name__ == "__main__":
    sys.exit(main())

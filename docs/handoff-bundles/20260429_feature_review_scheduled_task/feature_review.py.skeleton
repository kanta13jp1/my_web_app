def load_config(path: Path) -> dict:
    """feature_review_config.json を読み込み"""
    with path.open(encoding="utf-8") as f:
        return json.load(f)


def select_feature_for_this_hour(config: dict) -> str | None:
    """UTC 時刻 % len(feature_order) で本時刻の対象機能を選択.

    毎時 cron 用 rotation logic. force_full_scan / --targets 上書き時は呼ばない.

    Returns:
        feature slug (= rotation で選ばれた 1 機能) or None (= 不正設定)
    """
    from datetime import datetime, timezone
    rotation = config.get("rotation", {})
    feature_order = rotation.get("feature_order", [])
    if not feature_order:
        return None
    utc_hour = datetime.now(timezone.utc).hour
    idx = utc_hour % len(feature_order)
    return feature_order[idx]


def issue_title_hash(feature_slug: str, category: str, summary: str) -> str:
    """de-dupe 用 hash 計算"""
    key = f"{feature_slug}|{category}|{summary[:80]}"
    return hashlib.sha256(key.encode("utf-8")).hexdigest()[:8]



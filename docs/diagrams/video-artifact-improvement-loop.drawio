<mxfile host="app.diagrams.net" modified="2026-08-22T18:30:00.000Z" agent="Codex" version="24.7.17">
  <diagram id="video-artifact-loop" name="動画素材・改善ループ">
    <mxGraphModel dx="1600" dy="1020" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1020" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="生成動画を『資産』に変える保存・レビュー・改善ループ&lt;br&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;原本は非公開保存／改善は明示的な次回生成へ／販売公開は別承認&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#172554;gradientColor=#312e81;strokeColor=#6366f1;fontColor=#f8fafc;fontSize=28;fontStyle=1;align=left;spacingLeft=26;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1520" height="110" as="geometry"/></mxCell>
        <mxCell id="studio" value="&lt;b&gt;1. 動画Studio&lt;/b&gt;&lt;br&gt;&lt;br&gt;プロンプト・権利同意&lt;br&gt;5秒・720p・縦横比&lt;br&gt;&lt;br&gt;&lt;b&gt;動画を生成（明示操作）&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f2a4d;strokeColor=#60a5fa;fontColor=#f8fafc;fontSize=16;" vertex="1" parent="1"><mxGeometry x="60" y="210" width="260" height="190" as="geometry"/></mxCell>
        <mxCell id="api" value="&lt;b&gt;2. 生成受付API&lt;/b&gt;&lt;br&gt;&lt;br&gt;クレジット予約・冪等性&lt;br&gt;ジョブ作成・GPU起動&lt;br&gt;&lt;br&gt;改善時は親素材＋レビューを固定" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#132541;strokeColor=#60a5fa;fontColor=#f8fafc;fontSize=16;" vertex="1" parent="1"><mxGeometry x="380" y="210" width="275" height="190" as="geometry"/></mxCell>
        <mxCell id="gpu" value="&lt;b&gt;3. GCP専用GPU&lt;/b&gt;&lt;br&gt;&lt;br&gt;自社Workerで動画生成&lt;br&gt;MP4検証・サイズ取得&lt;br&gt;SHA-256を計算&lt;br&gt;&lt;br&gt;Hedra / fal APIは不使用" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#193044;strokeColor=#22d3ee;fontColor=#f8fafc;fontSize=16;" vertex="1" parent="1"><mxGeometry x="720" y="210" width="265" height="190" as="geometry"/></mxCell>
        <mxCell id="storage" value="&lt;b&gt;4. 非公開Storage&lt;/b&gt;&lt;br&gt;&lt;br&gt;固定パスにMP4原本&lt;br&gt;閲覧は短期署名URLのみ&lt;br&gt;&lt;br&gt;成功時だけ素材台帳へ登録&lt;br&gt;失敗時は返金・素材なし" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#10382f;strokeColor=#34d399;fontColor=#f8fafc;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1045" y="210" width="270" height="190" as="geometry"/></mxCell>
        <mxCell id="artifact" value="&lt;b&gt;5. 素材台帳&lt;/b&gt;&lt;br&gt;&lt;br&gt;原本・来歴&lt;br&gt;販売候補&lt;br&gt;権利確認待ち&lt;br&gt;&lt;br&gt;既存成功分も移行" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#173d2f;strokeColor=#34d399;fontColor=#f8fafc;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1370" y="210" width="170" height="190" as="geometry"/></mxCell>
        <mxCell id="review" value="&lt;b&gt;6. 所有者レビュー&lt;/b&gt;&lt;br&gt;&lt;br&gt;品質・指示一致・動き・販売価値&lt;br&gt;良い点・改善点・次回プロンプト&lt;br&gt;&lt;br&gt;keep / improve / reject を追記" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#482817;strokeColor=#fb923c;fontColor=#f8fafc;fontSize=16;" vertex="1" parent="1"><mxGeometry x="120" y="580" width="350" height="185" as="geometry"/></mxCell>
        <mxCell id="apply" value="&lt;b&gt;7. 改善案を入力欄へ反映&lt;/b&gt;&lt;br&gt;&lt;br&gt;改善版プロンプトを見える形で表示&lt;br&gt;元動画・採用レビューも表示&lt;br&gt;&lt;br&gt;&lt;b&gt;この時点では課金・自動生成しない&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#35224d;strokeColor=#c084fc;fontColor=#f8fafc;fontSize=16;" vertex="1" parent="1"><mxGeometry x="620" y="580" width="360" height="185" as="geometry"/></mxCell>
        <mxCell id="next" value="&lt;b&gt;8. 次回の有償生成&lt;/b&gt;&lt;br&gt;&lt;br&gt;利用者が生成ボタンを押す&lt;br&gt;通常どおり300 creditsを予約&lt;br&gt;&lt;br&gt;子動画から親素材・レビューを追跡" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#182d55;strokeColor=#60a5fa;fontColor=#f8fafc;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1125" y="580" width="350" height="185" as="geometry"/></mxCell>
        <mxCell id="rights" value="&lt;b&gt;権利・許諾の確認&lt;/b&gt;&lt;br&gt;&lt;br&gt;素材・人物・商用利用条件&lt;br&gt;未確認／NGなら公開へ進めない" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#263224;strokeColor=#a3e635;fontColor=#f8fafc;fontSize=16;" vertex="1" parent="1"><mxGeometry x="120" y="850" width="350" height="120" as="geometry"/></mxCell>
        <mxCell id="product" value="&lt;b&gt;商品化準備&lt;/b&gt;&lt;br&gt;&lt;br&gt;説明・価格・パッケージを別工程で作成&lt;br&gt;ショップ商品は非公開ドラフトから開始" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#183a31;strokeColor=#34d399;fontColor=#f8fafc;fontSize=16;" vertex="1" parent="1"><mxGeometry x="625" y="850" width="350" height="120" as="geometry"/></mxCell>
        <mxCell id="publish" value="&lt;b&gt;明示承認後のみ販売公開&lt;/b&gt;&lt;br&gt;&lt;br&gt;Stripe・ショップ・外部投稿&lt;br&gt;この改善ループは自動公開しない" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3b231b;strokeColor=#f59e0b;fontColor=#f8fafc;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1130" y="850" width="350" height="120" as="geometry"/></mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#60a5fa;strokeWidth=3;endArrow=block;endFill=1;" edge="1" parent="1" source="studio" target="api"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#60a5fa;strokeWidth=3;endArrow=block;endFill=1;" edge="1" parent="1" source="api" target="gpu"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#34d399;strokeWidth=3;endArrow=block;endFill=1;" edge="1" parent="1" source="gpu" target="storage"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#34d399;strokeWidth=3;endArrow=block;endFill=1;" edge="1" parent="1" source="storage" target="artifact"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#fb923c;strokeWidth=3;endArrow=block;endFill=1;" edge="1" parent="1" source="artifact" target="review"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#c084fc;strokeWidth=3;endArrow=block;endFill=1;" edge="1" parent="1" source="review" target="apply"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#c084fc;strokeWidth=3;endArrow=block;endFill=1;" edge="1" parent="1" source="apply" target="next"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" value="親素材＋レビュー" style="edgeStyle=orthogonalEdgeStyle;rounded=0;dashed=1;strokeColor=#60a5fa;strokeWidth=3;endArrow=block;endFill=1;fontColor=#93c5fd;" edge="1" parent="1" source="next" target="api"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#34d399;strokeWidth=3;endArrow=block;endFill=1;" edge="1" parent="1" source="rights" target="product"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" value="別途、明示承認" style="edgeStyle=orthogonalEdgeStyle;rounded=0;dashed=1;strokeColor=#f59e0b;strokeWidth=3;endArrow=block;endFill=1;fontColor=#fdba74;" edge="1" parent="1" source="product" target="publish"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

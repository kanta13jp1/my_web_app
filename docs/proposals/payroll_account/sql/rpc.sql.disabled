-- DRAFT FOR REVIEW ONLY. DO NOT EXECUTE, MIGRATE, OR DISPATCH.
-- Unverified additive candidate for a disposable synthetic environment only.
-- Existing authenticated account INSERT remains granted: this candidate
-- ALONE DOES NOT prevent legacy/direct writers from creating duplicates.
-- The account selection, deletion/retention, RLS, roles, locking and rollout
-- contracts in REVIEW_AND_TESTS.md must be independently reviewed first.

begin;

-- Intentional fail-closed stop for accidental execution as one transaction.
-- A client that splits or skips statements can bypass this: never execute it.
do $review_only$ begin
  raise exception 'REVIEW ONLY: draft DDL execution is prohibited';
end $review_only$;

create table payroll_snapshot_private.account_create_heads_v1 (
  user_id uuid primary key references auth.users(id) on delete cascade,
  revision bigint not null default 0
    check (revision between 0 and 9007199254740991)
);

create table payroll_snapshot_private.account_create_receipts_v1 (
  user_id uuid not null references auth.users(id) on delete cascade,
  request_id uuid not null,
  account_id uuid not null,
  expected_revision bigint not null check (expected_revision >= 0),
  committed_revision bigint not null check (committed_revision > 0),
  label_snapshot text not null check (length(label_snapshot) between 1 and 120),
  confirmed_initial boolean not null check (confirmed_initial),
  created_at timestamptz not null default pg_catalog.now(),
  primary key (user_id, request_id),
  unique (user_id, account_id)
);

-- Deliberately no account FK in this candidate: retaining receipt evidence
-- after privileged deletion is a review question, NOT a settled policy.
-- User deletion currently cascades both new rows and needs separate review.
alter table payroll_snapshot_private.account_create_heads_v1 enable row level security;
alter table payroll_snapshot_private.account_create_receipts_v1 enable row level security;
revoke all on payroll_snapshot_private.account_create_heads_v1,
  payroll_snapshot_private.account_create_receipts_v1 from public, anon, authenticated;

create function payroll_snapshot_private.payroll_account_revision_v1()
returns jsonb
language plpgsql security definer set search_path = '' as $revision$
declare
  v_user uuid := auth.uid();
  v_revision bigint;
begin
  if v_user is null then
    raise exception 'Authentication required' using errcode = '42501';
  end if;
  select h.revision into v_revision
    from payroll_snapshot_private.account_create_heads_v1 h
    where h.user_id = v_user;
  return pg_catalog.jsonb_build_object('revision', coalesce(v_revision, 0)::text);
end;
$revision$;
revoke all on function payroll_snapshot_private.payroll_account_revision_v1()
  from public, anon, authenticated;
grant execute on function payroll_snapshot_private.payroll_account_revision_v1()
  to authenticated;

create function payroll_snapshot_private.payroll_account_create_initial_v1(
  p_request_id uuid,
  p_account_id uuid,
  p_expected_revision bigint,
  p_display_label text,
  p_confirm_initial boolean
) returns jsonb
language plpgsql security definer set search_path = '' as $create$
declare
  v_user uuid := auth.uid();
  v_revision bigint;
  v_next_revision bigint;
  v_prior payroll_snapshot_private.account_create_receipts_v1%rowtype;
begin
  if v_user is null or p_confirm_initial is distinct from true then
    raise exception 'Authentication and confirmation required' using errcode = '42501';
  end if;
  if p_request_id is null or p_account_id is null or p_expected_revision is null
    or p_expected_revision < 0 or p_expected_revision > 9007199254740991
    or p_display_label is null or pg_catalog.length(p_display_label) not between 1 and 120
    or pg_catalog.btrim(p_display_label) = '' then
    raise exception 'Invalid request' using errcode = '22023';
  end if;

  -- Competing initializers meet at the same owner key. This is reviewed
  -- conceptually for READ COMMITTED, but has not been tested against PG.
  insert into payroll_snapshot_private.account_create_heads_v1(user_id, revision)
    values (v_user, 0) on conflict (user_id) do nothing;
  select h.revision into strict v_revision
    from payroll_snapshot_private.account_create_heads_v1 h
    where h.user_id = v_user for update;

  -- Receipt lookup intentionally precedes revision comparison for replay.
  select r.* into v_prior
    from payroll_snapshot_private.account_create_receipts_v1 r
    where r.user_id = v_user and r.request_id = p_request_id;
  if found then
    if v_prior.account_id is distinct from p_account_id
      or v_prior.expected_revision is distinct from p_expected_revision
      or v_prior.label_snapshot is distinct from p_display_label
      or v_prior.confirmed_initial is distinct from p_confirm_initial then
      raise exception 'Request reused with different content' using errcode = '22023';
    end if;
    -- Receipt describes a past commit, not the account's present state.
    return pg_catalog.jsonb_build_object(
      'status', 'matching_receipt',
      'committed_revision', v_prior.committed_revision::text,
      'current_revision', v_revision::text,
      'account_id', v_prior.account_id::text
    );
  end if;

  if v_revision is distinct from p_expected_revision then
    raise exception 'Account state changed; reload' using errcode = '40001';
  end if;
  if v_revision >= 9007199254740991 then
    raise exception 'Revision limit reached' using errcode = '22003';
  end if;
  perform 1 from public.asset_payroll_accounts a
    where a.user_id = v_user and not a.archived;
  if found then
    return pg_catalog.jsonb_build_object(
      'status', 'existing_selection_required',
      'current_revision', v_revision::text
    );
  end if;

  v_next_revision := v_revision + 1;
  insert into public.asset_payroll_accounts(user_id, id, display_label)
    values (v_user, p_account_id, p_display_label);
  insert into payroll_snapshot_private.account_create_receipts_v1(
    user_id, request_id, account_id, expected_revision,
    committed_revision, label_snapshot, confirmed_initial
  ) values (
    v_user, p_request_id, p_account_id, p_expected_revision,
    v_next_revision, p_display_label, p_confirm_initial
  );
  update payroll_snapshot_private.account_create_heads_v1 h
    set revision = v_next_revision where h.user_id = v_user;
  return pg_catalog.jsonb_build_object(
    'status', 'created_in_transaction',
    'committed_revision', v_next_revision::text,
    'current_revision', v_next_revision::text,
    'account_id', p_account_id::text
  );
end;
$create$;
revoke all on function payroll_snapshot_private.payroll_account_create_initial_v1(
  uuid, uuid, bigint, text, boolean
) from public, anon, authenticated;
grant execute on function payroll_snapshot_private.payroll_account_create_initial_v1(
  uuid, uuid, bigint, text, boolean
) to authenticated;

create function public.payroll_account_revision_v1()
returns jsonb
language sql security invoker set search_path = '' as $wrapper_revision$
  select payroll_snapshot_private.payroll_account_revision_v1();
$wrapper_revision$;
revoke all on function public.payroll_account_revision_v1()
  from public, anon, authenticated;
grant execute on function public.payroll_account_revision_v1() to authenticated;

create function public.payroll_account_create_initial_v1(
  p_request_id uuid,
  p_account_id uuid,
  p_expected_revision bigint,
  p_display_label text,
  p_confirm_initial boolean
) returns jsonb
language sql security invoker set search_path = '' as $wrapper_create$
  select payroll_snapshot_private.payroll_account_create_initial_v1(
    p_request_id, p_account_id, p_expected_revision, p_display_label, p_confirm_initial
  );
$wrapper_create$;
revoke all on function public.payroll_account_create_initial_v1(
  uuid, uuid, bigint, text, boolean
) from public, anon, authenticated;
grant execute on function public.payroll_account_create_initial_v1(
  uuid, uuid, bigint, text, boolean
) to authenticated;

commit;

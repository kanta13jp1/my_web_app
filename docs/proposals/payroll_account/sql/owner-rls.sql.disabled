-- REVIEW ONLY. Synthetic role/GUC fixture; not real Supabase Auth or HTTP.
\set ON_ERROR_STOP on
do $stop$ begin raise exception 'REVIEW ONLY: execution prohibited'; end $stop$;
select 1 / ((count(*) = 1)::int) from public.payroll_transport_fixture_guard
  where token = :'fixture_token'::uuid;
begin;
set local role authenticated;
-- Seed D through the authenticated owner RPC so both owners have 4-table positives.
select set_config('request.jwt.claim.sub','dddddddd-0000-4000-8000-000000000004',true);
select public.confirm_payroll_balance_observation(
  'dddddddd-1111-4111-8111-111111111111','2030-01-01','synthetic-d',
  '2030-01-20','day',null,null,110,'synthetic d note',
  'dddddddd-3333-4333-8333-333333333333',null,'synthetic d reason',true);

select set_config('request.jwt.claim.sub','cccccccc-0000-4000-8000-000000000003',true);
do $c$ declare changed integer; begin
  if (select count(*) from public.asset_payroll_accounts where user_id='cccccccc-0000-4000-8000-000000000003') <> 2
    or (select count(*) from public.asset_payroll_balance_observations where user_id='cccccccc-0000-4000-8000-000000000003') <> 1
    or (select count(*) from public.asset_payroll_balance_selections where user_id='cccccccc-0000-4000-8000-000000000003') <> 1
    or (select count(*) from public.asset_payroll_balance_selection_history where user_id='cccccccc-0000-4000-8000-000000000003') <> 1
  then raise exception 'owner C positive rows missing'; end if;
  if exists (select 1 from public.asset_payroll_accounts where user_id='dddddddd-0000-4000-8000-000000000004')
    or exists (select 1 from public.asset_payroll_balance_observations where user_id='dddddddd-0000-4000-8000-000000000004')
    or exists (select 1 from public.asset_payroll_balance_selections where user_id='dddddddd-0000-4000-8000-000000000004')
    or exists (select 1 from public.asset_payroll_balance_selection_history where user_id='dddddddd-0000-4000-8000-000000000004')
  then raise exception 'owner C can read owner D rows'; end if;
  update public.asset_payroll_accounts set target_increase_yen=42
    where user_id='dddddddd-0000-4000-8000-000000000004';
  get diagnostics changed=row_count;
  if changed <> 0 then raise exception 'owner C updated owner D target'; end if;
  update public.asset_payroll_accounts set target_increase_yen=10
    where id='cccccccc-1111-4111-8111-111111111111';
  get diagnostics changed=row_count;
  if changed <> 1 then raise exception 'owner C target positive failed'; end if;
  begin
    perform public.confirm_payroll_balance_observation(
      'dddddddd-1111-4111-8111-111111111111','2030-02-01','synthetic-cross',
      '2030-02-20','day',null,null,100,'synthetic',
      'cccccccc-5555-4555-8555-555555555555',null,'synthetic',true);
    raise exception 'owner C foreign account RPC unexpectedly succeeded';
  exception when insufficient_privilege then null;
  end;
  perform public.confirm_payroll_balance_observation(
    'cccccccc-1111-4111-8111-111111111111','2030-02-01','synthetic-own-c',
    '2030-02-20','day',null,null,120,'synthetic',
    'cccccccc-6666-4666-8666-666666666666',null,'synthetic',true);
end $c$;

select set_config('request.jwt.claim.sub','dddddddd-0000-4000-8000-000000000004',true);
do $d$ declare changed integer; begin
  if (select count(*) from public.asset_payroll_accounts where user_id='dddddddd-0000-4000-8000-000000000004') <> 1
    or (select count(*) from public.asset_payroll_balance_observations where user_id='dddddddd-0000-4000-8000-000000000004') <> 1
    or (select count(*) from public.asset_payroll_balance_selections where user_id='dddddddd-0000-4000-8000-000000000004') <> 1
    or (select count(*) from public.asset_payroll_balance_selection_history where user_id='dddddddd-0000-4000-8000-000000000004') <> 1
  then raise exception 'owner D positive rows missing'; end if;
  if exists (select 1 from public.asset_payroll_accounts where user_id='cccccccc-0000-4000-8000-000000000003')
    or exists (select 1 from public.asset_payroll_balance_observations where user_id='cccccccc-0000-4000-8000-000000000003')
    or exists (select 1 from public.asset_payroll_balance_selections where user_id='cccccccc-0000-4000-8000-000000000003')
    or exists (select 1 from public.asset_payroll_balance_selection_history where user_id='cccccccc-0000-4000-8000-000000000003')
  then raise exception 'owner D can read owner C rows'; end if;
  if (select target_increase_yen from public.asset_payroll_accounts
      where id='dddddddd-1111-4111-8111-111111111111') is not null
  then raise exception 'owner C changed owner D target'; end if;
  update public.asset_payroll_accounts set target_increase_yen=42
    where user_id='cccccccc-0000-4000-8000-000000000003';
  get diagnostics changed=row_count;
  if changed <> 0 then raise exception 'owner D updated owner C target'; end if;
  update public.asset_payroll_accounts set target_increase_yen=10
    where id='dddddddd-1111-4111-8111-111111111111';
  get diagnostics changed=row_count;
  if changed <> 1 then raise exception 'owner D target positive failed'; end if;
  begin
    perform public.confirm_payroll_balance_observation(
      'cccccccc-1111-4111-8111-111111111111','2030-02-01','synthetic-cross',
      '2030-02-20','day',null,null,100,'synthetic',
      'dddddddd-5555-4555-8555-555555555555',null,'synthetic',true);
    raise exception 'owner D foreign account RPC unexpectedly succeeded';
  exception when insufficient_privilege then null;
  end;
  perform public.confirm_payroll_balance_observation(
    'dddddddd-1111-4111-8111-111111111111','2030-02-01','synthetic-own-d',
    '2030-02-20','day',null,null,120,'synthetic',
    'dddddddd-6666-4666-8666-666666666666',null,'synthetic',true);
end $d$;

reset role;
-- Observe both owners' own writes and cross-owner non-mutation as the fixture
-- administrator before rolling this entire synthetic transaction back.
do $post$ begin
  if (select target_increase_yen from public.asset_payroll_accounts
      where user_id='cccccccc-0000-4000-8000-000000000003'
        and id='cccccccc-1111-4111-8111-111111111111') is distinct from 10
    or (select target_increase_yen from public.asset_payroll_accounts
      where user_id='dddddddd-0000-4000-8000-000000000004'
        and id='dddddddd-1111-4111-8111-111111111111') is distinct from 10
    or (select count(*) from public.asset_payroll_balance_observations
      where user_id='cccccccc-0000-4000-8000-000000000003') <> 2
    or (select count(*) from public.asset_payroll_balance_observations
      where user_id='dddddddd-0000-4000-8000-000000000004') <> 2
    or (select count(*) from public.asset_payroll_balance_selections
      where user_id='cccccccc-0000-4000-8000-000000000003') <> 2
    or (select count(*) from public.asset_payroll_balance_selections
      where user_id='dddddddd-0000-4000-8000-000000000004') <> 2
    or (select count(*) from public.asset_payroll_balance_selection_history
      where user_id='cccccccc-0000-4000-8000-000000000003') <> 2
    or (select count(*) from public.asset_payroll_balance_selection_history
      where user_id='dddddddd-0000-4000-8000-000000000004') <> 2
  then raise exception 'synthetic owner post-state differs'; end if;
end $post$;
select set_config('request.jwt.claim.sub','',true);
set local role anon;
do $anon$ begin
  begin perform 1 from public.asset_payroll_accounts limit 1;
    raise exception 'anon account select unexpectedly succeeded';
  exception when insufficient_privilege then null; end;
  begin perform 1 from public.asset_payroll_balance_observations limit 1;
    raise exception 'anon observation select unexpectedly succeeded';
  exception when insufficient_privilege then null; end;
  begin perform 1 from public.asset_payroll_balance_selections limit 1;
    raise exception 'anon selection select unexpectedly succeeded';
  exception when insufficient_privilege then null; end;
  begin perform 1 from public.asset_payroll_balance_selection_history limit 1;
    raise exception 'anon history select unexpectedly succeeded';
  exception when insufficient_privilege then null; end;
  begin
    perform public.confirm_payroll_balance_observation(
      'dddddddd-1111-4111-8111-111111111111','2030-03-01','synthetic-anon',
      '2030-03-20','day',null,null,100,'synthetic',
      'dddddddd-7777-4777-8777-777777777777',null,'synthetic',true);
    raise exception 'anon RPC unexpectedly succeeded';
  exception when insufficient_privilege then null; end;
end $anon$;
rollback;

  "credential_rules": {
    "SUPABASE_SECRET_KEY": {
      "strategy": "supabase_management_api",
      "cadence_days": 90,
      "warning_before_days": 14,
      "grace_hours": 24,
      "revocation_policy": "after_grace_window",
      "supports_auto_reissue": true,
      "supports_auto_revoke": true,
      "stores": [
        "supabase_api_keys",
        "github_actions_env",
        "supabase_vault"
      ],
      "description": "Modern Supabase secret key managed via Management API (/v1/projects/{ref}/api-keys) with old-key revocation after grace window."
    },
    "SUPABASE_PUBLISHABLE_KEY": {
      "strategy": "supabase_management_api",
      "cadence_days": 180,
      "warning_before_days": 30,
      "grace_hours": 72,
      "revocation_policy": "after_grace_window",
      "supports_auto_reissue": true,
      "supports_auto_revoke": true,
      "stores": [
        "supabase_api_keys",
        "github_actions_env"
      ],
      "description": "Modern Supabase publishable key with zero-downtime dual-key overlap window."
    },
    "INTERNAL_HMAC_SECRET": {
      "strategy": "csprng_dual_secret",
      "cadence_days": 60,
      "warning_before_days": 10,
      "grace_hours": 48,
      "revocation_policy": "after_grace_window",
      "supports_auto_reissue": true,
      "supports_auto_revoke": true,
      "stores": [
        "supabase_edge_secrets",
        "github_actions_env",
        "supabase_vault"
      ],
      "description": "Internal HMAC signing credential rotated via CSPRNG dual-secret propagation (new active + grace previous slot)."
    },
    "SUPABASE_URL": {
      "strategy": "static_endpoint_identifier",
      "cadence_days": 3650,
      "warning_before_days": 30,
      "grace_hours": 0,
      "revocation_policy": "none",
      "supports_auto_reissue": false,
      "supports_auto_revoke": false,
      "stores": [
        "github_actions_env"
      ],
      "description": "Non-secret project URL tracked for completeness; rotation not applicable."
    },
    "SUPABASE_ANON_KEY": {
      "strategy": "supabase_legacy_migration_guard",
      "cadence_days": 180,
      "warning_before_days": 30,
      "grace_hours": 72,
      "revocation_policy": "manual_cutover_required",
      "supports_auto_reissue": false,
      "supports_auto_revoke": false,
      "stores": [
        "supabase_api_keys",
        "github_actions_env"
      ],
      "description": "Legacy anon JWT key; track SLA and migrate consumers to publishable keys."
    },
    "SUPABASE_SERVICE_ROLE_KEY": {
      "strategy": "supabase_legacy_migration_guard",
      "cadence_days": 90,
      "warning_before_days": 14,
      "grace_hours": 72,
      "revocation_policy": "manual_cutover_required",
      "supports_auto_reissue": false,
      "supports_auto_revoke": false,
      "stores": [
        "github_actions_env",
        "supabase_vault"
      ],
      "description": "Legacy service_role JWT key covered by temporary exceptions; track SLA and migration to scoped OIDC / sb_secret_ keys."
    },
    "SERVICE_ROLE_KEY": {
      "strategy": "supabase_legacy_migration_guard",
      "cadence_days": 90,
      "warning_before_days": 14,
      "grace_hours": 72,
      "revocation_policy": "manual_cutover_required",
      "supports_auto_reissue": false,
      "supports_auto_revoke": false,
      "stores": [
        "supabase_edge_secrets"
      ],
      "description": "Legacy Edge Function fallback alias for SUPABASE_SERVICE_ROLE_KEY."
    },
    "GITHUB_PAT": {
      "strategy": "github_oidc_migration_guard",
      "cadence_days": 90,
      "warning_before_days": 14,
      "grace_hours": 24,
      "revocation_policy": "manual_cutover_required",
      "supports_auto_reissue": false,
      "supports_auto_revoke": false,
      "stores": [
        "github_actions_secret",
        "supabase_edge_secrets"
      ],
      "description": "Legacy PAT monitored for 90-day expiry and incremental replacement with GitHub Actions OIDC / App installation credentials."
    }
  }

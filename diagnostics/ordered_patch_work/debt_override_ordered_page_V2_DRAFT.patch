+  /// Atomically compare queued mutation generation and caller state before clear.
+  Future<void> clearDomainIfUnchanged(String prefKey, {
+    required int generation,
+    required bool Function(Set<String>) isCurrent,
+    SharedPreferences? prefs,
+  }) {
+    return _runLocked(() async {
+      final store = prefs ?? await SharedPreferences.getInstance();
+      final all = await _loadAll(store);
+      if (_mutationGeneration != generation + 1 ||
+          !isCurrent(Set<String>.unmodifiable(all[prefKey] ?? <String>{}))) return;

# Environment Configuration Template
# Copy this file to .env.development, .env.staging, or .env.production
# and fill in the actual values for each environment

# ================================
# Supabase Configuration
# ================================
# Supabase project URL (e.g., https://xxxxx.supabase.co)
SUPABASE_URL=your_supabase_url_here

# Supabase anonymous key (public key for client-side use)
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase project reference ID (for CLI operations)
SUPABASE_PROJECT_ID=your_supabase_project_id_here

# Supabase database password (for migrations and admin operations)
SUPABASE_DB_PASSWORD=your_db_password_here

# ================================
# Firebase Configuration
# ================================
# Firebase project ID
FIREBASE_PROJECT_ID=your_firebase_project_id_here

# Firebase hosting site (optional, defaults to project ID)
FIREBASE_HOSTING_SITE=your_firebase_hosting_site_here

# ================================
# Google AI Configuration
# ================================
# Google AI API Key for AI features
GOOGLE_AI_API_KEY=your_google_ai_api_key_here

# X / Twitter API Configuration
# ================================
# Use credentials from an X Developer App attached to a Project.
# Posting requires OAuth 1.0a user tokens with Read and write permissions.
X_API_KEY=your_x_api_key_here
X_API_SECRET=your_x_api_secret_here
X_ACCESS_TOKEN=your_x_access_token_here
X_ACCESS_TOKEN_SECRET=your_x_access_token_secret_here
X_ACCOUNT_HANDLE=@your_x_account_handle

# ================================
# Stripe Billing Configuration
# ================================
# Secret key used only by Supabase Edge Functions
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

# Webhook signing secret for supabase/functions/stripe-webhook
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Stripe recurring price IDs used by schedule-hub billing actions
STRIPE_PRO_PRICE_ID=price_your_pro_monthly_price_id_here
STRIPE_TEAM_PRICE_ID=price_your_team_monthly_price_id_here

# Public app base URL used for Stripe return URLs
PUBLIC_SITE_URL=https://my-web-app-b67f4.web.app

# ================================
# Environment Identifier
# ================================
# Environment name: development, staging, production
ENVIRONMENT=development

# ================================
# Feature Flags (Optional)
# ================================
# Enable/disable AI features
ENABLE_AI_FEATURES=true

# Enable/disable analytics
ENABLE_ANALYTICS=true

# Enable debug logging
DEBUG_MODE=true

# ================================
# CI/CD Secrets (GitHub Actions only)
# ================================
# These are set in GitHub Secrets, not in .env files

# FIREBASE_TOKEN - Firebase CI token for deployments
# SUPABASE_ACCESS_TOKEN - Supabase access token for CLI operations
# SLACK_WEBHOOK_URL - Slack webhook for deployment notifications

# ================================
# Supabase Edge Function Secrets (server-side only)
# ================================
# Set via: supabase secrets set KEY=value  (never commit real values)

# Cartesia account key and production voice ID used by AI Hub to mint
# short-lived, TTS-only browser tokens for support voice calls.
CARTESIA_API_KEY=sk_car_your_server_side_key_here
CARTESIA_VOICE_ID=your_cartesia_voice_id_here

# GH_ACTIONS_READ_TOKEN - fine-grained GitHub PAT (repo: my_web_app,
#   permissions: Actions read-only + Metadata read-only) used by the
#   `autonomous-ops` Edge Function to render the OMOCHA WORKS console with
#   real GitHub Actions data (owner-only). See docs/AUTONOMOUS_OPS_CONSOLE.md
# GITHUB_REPO - optional target repo for autonomous-ops (default kanta13jp1/my_web_app)

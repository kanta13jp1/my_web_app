#!/usr/bin/env bash
# Push前に COMPRESSED_PROMPT.md 同期状態と origin/main との差分（git pull --rebase 済みか）を検証する。
# 有効化: git config core.hooksPath .githooks
set -euo pipefail

if [ "${SKIP_PRE_PUSH_SYNC:-0}" = "1" ]; then
  echo "pre-push: SKIP_PRE_PUSH_SYNC=1 のため同期チェックをスキップします。" >&2
  exit 0
fi

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

python_bin="python"
command -v python >/dev/null 2>&1 || python_bin="python3"

if ! "$python_bin" -B scripts/sync_compressed_prompt.py --check; then
  echo "" >&2
  echo "pre-push: COMPRESSED_PROMPT.md または同期契約が最新ではありません。'python scripts/sync_compressed_prompt.py --write' を確認してください。" >&2
  exit 1
fi

if git rev-parse --verify origin/main >/dev/null 2>&1; then
  git fetch --quiet origin main >/dev/null 2>&1 || true
  behind_count="$(git rev-list --count HEAD..origin/main 2>/dev/null || echo 0)"
  if [ "${behind_count}" -gt 0 ]; then
    echo "" >&2
    echo "pre-push: ローカルブランチが origin/main より ${behind_count} コミット遅れています。" >&2
    echo "競合回避のため先に 'git pull --rebase origin main' を実行してから再プッシュしてください。" >&2
    exit 1
  fi
fi

exit 0
